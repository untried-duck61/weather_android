<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WeatherForecast" parent="Theme.Material3Expressive.DynamicColors.Light.NoActionBar">
        <!-- There is nothing to show here -->
    </style>

    <style name="Theme.WeatherForecast" parent="Base.Theme.WeatherForecast" />

    <style name="CustomExpressiveCenteredDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog.Centered">
        <!-- Указываем кастомный стиль для положительной кнопки -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Alert.Button.Expressive.Filled</item>
    </style>

    <!-- 2. Стиль кнопки: берем Экспрессивную текстовую и превращаем в Заполненную -->
    <style name="Widget.Alert.Button.Expressive.Filled" parent="Widget.Material3Expressive.Button.TextButton">
        <!-- Красим контейнер кнопки в цвет Primary -->
        <item name="backgroundTint">?attr/colorPrimary</item>
        <!-- Текст делаем контрастным (OnPrimary) -->
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <!-- Иконки (если будут) красятся в цвет текста -->
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>
</resources>